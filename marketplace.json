{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "impulso-bb",
  "displayName": "Impulso BB",
  "description": "bb plugins by alexandrekm, installed from npm.",
  "plugins": [
    {
      "id": "worktree-hooks",
      "displayName": "Worktree Hooks",
      "description": "Run per-project scripts before and after a thread's git worktree is created, before the agent starts.",
      "icon": "FolderGit",
      "tags": [
        "worktree",
        "hooks",
        "git"
      ],
      "author": {
        "name": "Alexandre Mendonça",
        "github": "alexandrekm"
      },
      "source": {
        "npm": {
          "package": "bb-plugin-worktree-hooks",
          "range": "^0.1.0"
        }
      }
    },
    {
      "id": "umbrella-repos",
      "displayName": "Umbrella Repos",
      "description": "See git status, diffs and GitHub pull requests for every repo inside a multi-repo (umbrella) folder.",
      "icon": "FolderGit",
      "tags": [
        "git",
        "pull-requests",
        "multi-repo"
      ],
      "author": {
        "name": "Alexandre Mendonça",
        "github": "alexandrekm"
      },
      "source": {
        "npm": {
          "package": "bb-plugin-umbrella-repos",
          "range": "^0.3.0"
        }
      }
    },
    {
      "id": "impulso-stats",
      "displayName": "Impulso Stats",
      "description": "Overall Pi usage, model and project breakdowns, and per-thread session statistics.",
      "icon": "ChartNoAxesCombined",
      "tags": [
        "stats",
        "usage",
        "pi"
      ],
      "author": {
        "name": "Alexandre Mendonça",
        "github": "alexandrekm"
      },
      "source": {
        "npm": {
          "package": "bb-plugin-impulso-stats",
          "range": "^0.2.0"
        }
      }
    }
  ]
}
