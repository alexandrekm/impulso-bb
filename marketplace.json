{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "impulso-bb",
  "displayName": "Impulso BB",
  "description": "bb plugins by alexandrekm, installed from npm, plus reviewed third-party plugins pinned to a git commit.",
  "plugins": [
    {
      "id": "worktree-hooks",
      "displayName": "Worktree Hooks",
      "description": "Run per-project scripts before and after a thread's git worktree is created, before the agent starts.",
      "icon": "FolderGit",
      "tags": [
        "worktree",
        "hooks",
        "git"
      ],
      "author": {
        "name": "Alexandre Mendonça",
        "github": "alexandrekm"
      },
      "source": {
        "npm": {
          "package": "bb-plugin-worktree-hooks",
          "range": "^0.1.0"
        }
      }
    },
    {
      "id": "umbrella-repos",
      "displayName": "Umbrella Repos",
      "description": "See git status, diffs and GitHub pull requests for every repo inside a multi-repo (umbrella) folder.",
      "icon": "FolderGit",
      "tags": [
        "git",
        "pull-requests",
        "multi-repo"
      ],
      "author": {
        "name": "Alexandre Mendonça",
        "github": "alexandrekm"
      },
      "source": {
        "npm": {
          "package": "bb-plugin-umbrella-repos",
          "range": "^0.3.0"
        }
      }
    },
    {
      "id": "impulso-stats",
      "displayName": "Impulso Stats",
      "description": "Overall Pi usage, model and project breakdowns, and per-thread session statistics.",
      "icon": "ChartNoAxesCombined",
      "tags": [
        "stats",
        "usage",
        "pi"
      ],
      "author": {
        "name": "Alexandre Mendonça",
        "github": "alexandrekm"
      },
      "source": {
        "npm": {
          "package": "bb-plugin-impulso-stats",
          "range": "^0.2.0"
        }
      }
    },
    {
      "id": "plan-pin",
      "displayName": "Plan",
      "description": "The agent's plan and the thread's source Jira or GitHub issue in two lines above the composer; click for the full step list. Needs impulso-pi's prompt rules.",
      "icon": "ListChecks",
      "tags": [
        "plan",
        "jira",
        "pi"
      ],
      "author": {
        "name": "Alexandre Mendonça",
        "github": "alexandrekm"
      },
      "source": {
        "npm": {
          "package": "bb-plugin-plan-pin",
          "range": "^0.4.0"
        }
      }
    },
    {
      "id": "side-cards",
      "displayName": "Side Cards",
      "description": "A Cards tab with each thread's live commands and tool calls, plus an optional Iris card of the last turn drawn by pi's smallModel (off by default).",
      "icon": "PanelRight",
      "tags": [
        "iris",
        "activity",
        "pi"
      ],
      "author": {
        "name": "Alexandre Mendonça",
        "github": "alexandrekm"
      },
      "source": {
        "npm": {
          "package": "bb-plugin-side-cards",
          "range": "^0.2.0"
        }
      }
    },
    {
      "id": "cache-guard",
      "displayName": "Cache Guard",
      "description": "Offers to compact a thread whose prompt cache has expired before the next message re-sends cold context; for models that report no cache TTL (OpenAI-style, cpa, litellm).",
      "icon": "TimerReset",
      "tags": [
        "prompt-cache",
        "compaction",
        "cost"
      ],
      "author": {
        "name": "Alexandre Mendonça",
        "github": "alexandrekm"
      },
      "source": {
        "npm": {
          "package": "bb-plugin-cache-guard",
          "range": "^0.2.0"
        }
      }
    },
    {
      "id": "tok-speed",
      "displayName": "Tok Speed",
      "description": "Shows the visible provider-output tokens-per-second for each assistant message in its hover menu.",
      "icon": "Gauge",
      "tags": [
        "tokens",
        "speed",
        "performance"
      ],
      "author": {
        "name": "Patrick Lee",
        "github": "patleeman"
      },
      "source": {
        "git": {
          "url": "https://github.com/patleeman/bb-plugins.git",
          "subdir": "packages/bb-plugin-tok-speed",
          "ref": "d8edb695e07e665d0ee02e7449818d4309852cff"
        }
      }
    }
  ]
}